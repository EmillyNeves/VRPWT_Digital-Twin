digraph G {
  graph [rankdir=LR, splines=true, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=10];
  node  [shape=circle, fixedsize=true, width=0.45, fontname="Helvetica", fontsize=10];
  edge  [color="#1f2937", penwidth=1.3];

  subgraph cluster_before {
    label="Antes: swap_intra";
    color="#9ca3af";
    style=rounded;
    b0 [label="0"];
    b1 [label="A"];
    b2 [label="B", style=filled, fillcolor="#fde68a"];
    b3 [label="C"];
    b4 [label="D", style=filled, fillcolor="#fde68a"];
    b5 [label="0"];
    b0 -> b1 -> b2 -> b3 -> b4 -> b5;
  }

  subgraph cluster_after {
    label="Depois: troca B e D";
    color="#9ca3af";
    style=rounded;
    a0 [label="0"];
    a1 [label="A"];
    a2 [label="D", style=filled, fillcolor="#86efac"];
    a3 [label="C"];
    a4 [label="B", style=filled, fillcolor="#86efac"];
    a5 [label="0"];
    a0 -> a1 -> a2 -> a3 -> a4 -> a5;
  }
}
